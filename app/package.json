{
  "name": "blazz-artifacts",
  "version": "0.1.0",
  "description": "Self-hosted hub to publish and share HTML, Markdown, PDF, JSON and ZIP artifacts",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node src/main.ts",
    "dev": "node dev/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "beautiful-mermaid": "^1.1.3",
    "busboy": "^1.6.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.18",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "sanitize-html": "^2.18.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@types/busboy": "^1.5.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
