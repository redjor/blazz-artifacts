# Copy to .env next to the compose file and fill in. Never commit .env.

TZ=UTC

# openssl rand -base64 48
# Never change HUB_SECRET without re-creating share links and signing in again.
HUB_SECRET=

# read -s P; printf %s "$P" | docker run --rm -i --network none blazz-artifacts:local node src/scripts/hash-password.ts
ADMIN_PASSWORD_HASH=

# API token for automation (publish CLI). Leave empty to disable.
# docker run --rm --network none blazz-artifacts:local node src/scripts/new-api-token.ts
# The token (token= line) goes to the publish CLI (Keychain or ARTIFACT_HUB_TOKEN), the hash (hash= line) here.
API_TOKEN_HASH=

# Public origins of the two servers (https, no trailing path).
# Reverse proxy example:  https://admin.example.com  and  https://artifacts.example.com
# Tailscale example:      https://artifacts-admin.<tailnet>.ts.net  and  https://artifacts.<tailnet>.ts.net
PUBLIC_HUB_URL=https://admin.example.com
PUBLIC_CONTENT_URL=https://artifacts.example.com
# Optional: other origins of the same admin, comma-separated (e.g. tailnet name + public name behind Cloudflare Access).
# PUBLIC_HUB_ALT_URLS=https://artifacts-admin.<tailnet>.ts.net

# Language of the visitor pages: en (default), fr, or auto (follows the visitor's Accept-Language).
HUB_LOCALE=en

MAX_UPLOAD_MB=100
ZIP_MAX_FILES=2000
ZIP_MAX_BYTES=209715200

# docker-compose.yml only: host loopback ports.
# ADMIN_PORT=3000
# CONTENT_PORT=3001

# docker-compose.tailscale.yml only: tagged, non-reusable, non-ephemeral auth keys and node names.
# TS_AUTHKEY_ADMIN=
# TS_AUTHKEY_CONTENT=
# TS_ADMIN_HOSTNAME=artifacts-admin
# TS_CONTENT_HOSTNAME=artifacts
